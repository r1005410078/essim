{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESSim",
  "version": "0.1.0",
  "identifier": "dev.essim.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ESSim · 储能协议仿真工作台",
        "width": 1280,
        "height": 800,
        "center": true,
        "visible": false,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
