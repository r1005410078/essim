{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESSim",
  "version": "0.1.0",
  "identifier": "dev.essim.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ESSim · 储能设备实验室",
        "width": 1440,
        "height": 980,
        "minWidth": 900,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": { "active": false }
}
